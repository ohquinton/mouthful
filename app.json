{
  "expo": {
    "name": "SaidClearly",
    "slug": "mouthful",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ca.quintonjackson.mouthful",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2F49F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ca.quintonjackson.mouthful"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "SaidClearly listens while you practise so it can follow along. Recordings are kept only if you choose, on this phone (and in its backup, if you use one).",
          "speechRecognitionPermission": "SaidClearly turns your speech into text to follow what you say and check your pace, fillers and flow. Depending on your phone and the English you pick, your speech may be sent to Apple to be transcribed. SaidClearly asks you first."
        }
      ],
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "SaidClearly listens while you practise so it can follow along. Recordings are kept only if you choose, on this phone (and in its backup, if you use one).",
          "enableBackgroundPlayback": false
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "mouthful",
          "project": "mouthful-app"
        }
      ]
    ],
    "scheme": "mouthful",
    "experiments": {
      "typedRoutes": true
    }
  }
}
