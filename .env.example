# Copy to .env and fill in. Nothing here is secret enough to hide from the app bundle,
# but don't commit real keys to a public repo.

# RevenueCat public SDK keys (Project settings → API keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# PostHog project API key (Project settings). Leave empty to send no analytics.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry crash reports (Project settings → Client Keys). Leave empty to send none.
# Off whenever the reader switches off usage counts. SENTRY_AUTH_TOKEN (source maps) is an EAS secret, never here.
EXPO_PUBLIC_SENTRY_DSN=

# Show the tester-mode switch without the hidden 7 taps (beta builds only)
# EXPO_PUBLIC_TESTER_MODE=1
